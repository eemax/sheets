# Newer Excel functions are stored the way Excel expects, and the engine
# says when it cannot evaluate something rather than reporting an error.
stdin data.tsv
exec sheets write book.xlsx

exec sheets set book.xlsx D1 '=XLOOKUP("b",A2:A4,B2:B4)' F2 '=UNIQUE(A2:A4)' D3 '=LET(x,B2,x*2)' D4 '=NOPE(1)' D5 '=FILTERXML("<a><b>2</b></a>","//b")'
stdout 'formulas: Sheet1!D1 = 2, Sheet1!F2 = "a" \(spills\), Sheet1!D3 = 2'
stdout '1 formula error: Sheet1!D4 #NAME\? \(unknown function NOPE\)'
stdout 'not evaluated: Sheet1!D5: FILTERXML is not supported by the sheets calculator; Excel computes it on open'

# Formulas read back as typed, without the file format's prefixes.
exec sheets read book.xlsx D1:D3 --formulas
cmp stdout formulas.out

exec sheets read book.xlsx D5
stdout '^5\t\?$'


# A formula computing over a range where one value goes is stored as Excel
# 365 stores it, a dynamic array formula, so that Excel computes it over
# the whole range as written; a whole column in the result still means the
# formula's row, as written for older Excel.
exec sheets set arrays.xlsx A1 3 A2 1 A3 2 D1 '=SUM(IF(A1:A3>1,A1:A3))' E1 '=A1:A3*2' F1 '=B:B*2'
stdout 'D1 = 5, Sheet1!E1 = 6 \(spills\), Sheet1!F1 = 0'
exec sheets read arrays.xlsx D1:F1
stdout '^1	5	6	0$'

# A dynamic array is saved as Excel saves it: the cells it spills into
# hold their values, for every reader of the file. One that would cover
# values is #SPILL!; when its result grows or shrinks, so does its range.
exec sheets read book.xlsx F2:F4
stdout '^2	a$'
stdout '^3	b$'
exec sheets set book.xlsx H3 x H2 '=UNIQUE(A2:A4)'
stdout '1 formula error: Sheet1!H2 #SPILL! \(#SPILL!: the result would cover cells that hold values; clear them\)'
exec sheets set book.xlsx A4 c
exec sheets read book.xlsx F2:F5
stdout '^4	c$'
exec sheets set book.xlsx A3 a A4 a
exec sheets read book.xlsx F2:F5
cmp stdout shrunk.out

# The spill operator: D2# is the range D2's dynamic array fills, stored as
# Excel stores it.
exec sheets set spill.xlsx A1 Red A2 Blue A3 Red C1 '=SORT(UNIQUE(A1:A3))' D1 '=COUNTA(C1#)' E1 '=C1#&"!"'
stdout 'Sheet1!D1 = 2, Sheet1!E1 = "Blue!" \(spills\)'
exec sheets read spill.xlsx C1:E2 --formulas
stdout '^1	=SORT\(UNIQUE\(A1:A3\)\)	=COUNTA\(C1#\)	=C1#&"!"$'
stdout '^2	Red		Red!$'

-- shrunk.out --
Sheet1!F2:F5
	F
2	a
3
4
5
-- data.tsv --
Name	Score
a	1
b	2
a	3
-- formulas.out --
Sheet1!D1:D3
	D
1	=XLOOKUP("b",A2:A4,B2:B4)
2
3	=LET(x,B2,x*2)
