exec sheets skill
stdout '^name: sheets$'
stdout 'guide for agents'

exec sheets skill --install --dir skills
stdout 'installed skills/sheets/SKILL.md'
exists skills/sheets/SKILL.md

# The skill is the guide's index; topics and the whole guide on demand.
exec sheets skill
stdout 'sheets agent-docs TOPIC'
! stdout '## Styling on request'
exec sheets agent-docs
stdout 'sheets agent-docs TOPIC'
exec sheets agent-docs cond sort
stdout '^## Styling on request: style, cond, validate, view$'
stdout '^## Moving data: clear, copy, move, sort, replace$'
! stdout '^## Reading$'
exec sheets agent-docs all
stdout '^## Reading$'
stdout '^## Exit status$'
! exec sheets agent-docs nope
stderr 'no topic "nope": give one of reading, query'
