# check --against --receipt writes the report for a person, as Markdown,
# with before and after pictures of the ranges that changed beside it.
fixture against_before.xlsx against_openpyxl.xlsx against_chartsheet.xlsx against_chartsheet_deleted.xlsx

# openpyxl's round trip, Data!B2 changed: the chart, its text box and the
# list validation lost, the values moved with their cause, the missing
# results. The chart is in the picture before, not after; the validation
# and the text box no picture shows, so the receipt says so in words. A
# picture an earlier receipt left under the same name is removed.
cp against_before.xlsx receipt-3-after.png
! exec sheets check against_openpyxl.xlsx --against against_before.xlsx --receipt receipt.md
stdout '^receipt: receipt.md \(4 pictures of 2 ranges\)$'
cmp receipt.md openpyxl.md
exists receipt-1-before.png receipt-1-after.png receipt-2-before.png receipt-2-after.png
! exists receipt-3-after.png

! exec sheets --json check against_openpyxl.xlsx --against against_before.xlsx --receipt receipt.md
stdout '"receipt":\{"file":"receipt.md","previews":\[\{"before":"Data!A1:G8","after":"Data!A1:G8","before_image":"receipt-1-before.png","after_image":"receipt-1-after.png"\},\{"before":"Summary!A1:C8","after":"Summary!A1:C8","before_image":"receipt-2-before.png","after_image":"receipt-2-after.png"\}\]\}'

# A sheet renamed: its picture before is of the sheet's old name; a name
# with a space is a link Markdown reads.
cp against_before.xlsx renamed.xlsx
exec sheets sheet rename renamed.xlsx Data 'My Facts'
exec sheets set renamed.xlsx 'My Facts!C3' 25
exec sheets check renamed.xlsx --against against_before.xlsx --receipt 'my receipt.md'
grep '^### 1. `''My Facts''!A1:E8 \(was Data!A1:E8\)`$' 'my receipt.md'
grep '^\| !\[Data!A1:E8 before\]\(<my receipt-1-before.png>\) \| !\[''My Facts''!A1:E8 after\]\(<my receipt-1-after.png>\) \|$' 'my receipt.md'
grep '^Here: 1 input changed \(C3\), 2 values moved \(D3, D7\)\.$' 'my receipt.md'
grep '^\*\*Every value that moved has its cause; no feature was lost\.\*\*$' 'my receipt.md'
exists 'my receipt-1-before.png' 'my receipt-1-after.png'

# A chart on a chart sheet is not drawn: said, with no picture.
! exec sheets check against_chartsheet_deleted.xlsx --against against_chartsheet.xlsx --receipt cs.md
stdout '^receipt: cs.md \(0 pictures of 0 ranges\)$'
grep '^Nothing changed that a picture shows\.$' cs.md
grep '^- chart Chart1 \(bar chart on a chart sheet\): a chart sheet is not drawn$' cs.md

# A CSV pair: values only, no pictures.
exec sheets check after.csv --against before.csv --receipt csv.md
grep '^\| Values changed \| 1 \|$' csv.md
grep '^A CSV file has no formatting to draw: no pictures\.$' csv.md

# Nothing changed.
exec sheets check against_before.xlsx --against against_before.xlsx --receipt same.md
grep '^\*\*No changes\.\*\*$' same.md

# --receipt goes with --against.
! exec sheets check against_before.xlsx --receipt r.md
stderr '--receipt writes what --against reports: give --against before.xlsx too'
! exec sheets check against_before.xlsx --against against_before.xlsx --receipt against_before.xlsx
stderr '--receipt against_before.xlsx is against_before.xlsx, which it would overwrite: name a .md file'
exec sheets check against_before.xlsx --against against_before.xlsx
stdout ': 0 inputs changed,'
exec sheets check --help
stdout '^      --receipt string +with --against: write the report as Markdown for a person, with before and after pictures beside it$'
stdout '^  sheets check book.xlsx --against before.xlsx --receipt receipt.md$'

-- before.csv --
a,b
1,2
3,4
-- after.csv --
a,b
1,2
3,5
-- openpyxl.md --
