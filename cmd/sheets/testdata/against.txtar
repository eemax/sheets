# check --against reports what changed since an earlier version of a
# workbook, and why, whoever wrote either file: the planted cases of the
# change report. against_before.xlsx is XlsxWriter's, with Excel's results
# stored: Summary's formulas read Data!B2:B6.
fixture against_before.xlsx against_openpyxl.xlsx vouched.xlsx

# An input changed: every value it moves is explained, by that input.
cp against_before.xlsx input.xlsx
exec sheets set input.xlsx Data!B3 10
exec sheets check input.xlsx --against against_before.xlsx
cmp stdout input.out

# openpyxl's round trip, Data!B2 changed: the moved values are explained,
# but the chart grouped with a text box, the text box and the list
# validation in Excel 2010's extension list are lost, and every stored
# result with them: exit 1.
! exec sheets check against_openpyxl.xlsx --against against_before.xlsx
cmp stdout openpyxl.out
! exec sheets --json check against_openpyxl.xlsx --against against_before.xlsx
stdout '"features_lost":\[\{"kind":"validation","where":"Data!A2:A6","what":"list validation"\},\{"kind":"chart","where":"Data!F2","what":"column chart"\},\{"kind":"shape","where":"Data!F2","what":"TextBox 2"\}\]'
stdout '\{"cell":"Summary!B3","before":"630","after":"660","cause":"input Data!B2","note":"computed by sheets: the file stores no result"\}'
stdout '"rule":"missing-result","severity":"error"'
stdout '"unexplained":\[\],'
stdout '"summary":\{"inputs_changed":1,"formulas_changed":0,"flagged":0,"moved":8,"unexplained":0,"features_lost":3,"unknown":0,"moved_rows":0\}'

# One row's formula broken: flagged, as unlike the rows around it; what it
# moves is explained by it.
cp against_before.xlsx broken.xlsx
exec sheets set broken.xlsx Data!D4 '=B4*C3'
exec sheets check broken.xlsx --against against_before.xlsx
cmp stdout broken.out

# A formula made a value: flagged too.
cp against_before.xlsx typed.xlsx
exec sheets set typed.xlsx Data!D5 90
exec sheets check typed.xlsx --against against_before.xlsx
stdout '^  Data!D5  =B5\*C5 → 90  \(a value where the rows around it compute =B\{r\}\*C\{r\}\)$'
stdout '^check of typed.xlsx: 0 errors, 1 warning, 0 notes$'

# A sort: moved rows, not changes. A formula reading a sorted row by its
# place moves, the sort its cause.
cp against_before.xlsx sorted.xlsx
exec sheets sort sorted.xlsx Data!A1:D6 Units
exec sheets check sorted.xlsx --against against_before.xlsx
cmp stdout sorted.out
exec sheets --json check sorted.xlsx --against against_before.xlsx
stdout '"moved_rows":\[\{"sheet":"Data","from":4,"to":2,"rows":1\},'
stdout '"changed":\[\],'

# Sorted, and a sorted row changed: it moved, and its change is a change.
# What reads a cell the sort spans by its place moves, the sort its cause.
cp against_before.xlsx reads.xlsx
exec sheets set reads.xlsx Summary!C1 '=Data!B4'
cp reads.xlsx sortedit.xlsx
exec sheets sort sortedit.xlsx Data!A1:D6 Units
exec sheets set sortedit.xlsx Data!C2 99
exec sheets check sortedit.xlsx --against reads.xlsx
stdout '^  Data!C2 \(was C4\)  input  50 → 99$'
stdout '^  Data!D2 \(was D4\)  150 → 297 +input Data!C2$'
stdout '^  Summary!C1 +3 → 5 +rows moved: Data!2:6$'
stdout '^  Data!2, were 4$'
stdout ', 0 unexplained,'

# Rows added and removed: totals Excel rewrites to take them in are not
# changes; what they move is explained by the rows.
cp against_before.xlsx rows.xlsx
exec sheets rows insert rows.xlsx Data!4
exec sheets set rows.xlsx Data!A4 Extra Data!B4 10 Data!C4 5 Data!D4 '=B4*C4'
exec sheets rows delete rows.xlsx Data!7
exec sheets check rows.xlsx --against against_before.xlsx
cmp stdout rows.out

# A row whose every value changed is a changed row, not one removed and
# one added.
cp against_before.xlsx retyped.xlsx
exec sheets set retyped.xlsx Data!A3 Extra Data!B3 10 Data!C3 5
exec sheets check retyped.xlsx --against against_before.xlsx
stdout '^  Data!A3  input  "South" → "Extra"$'
! stdout 'removed'

# A value that moved with nothing upstream changed: Excel stored 999 for
# =B2*2, which sheets computes as 10 once the formula is entered again.
cp vouched.xlsx again.xlsx
exec sheets set again.xlsx Data!C3 '=B2*2'
! exec sheets check again.xlsx --against vouched.xlsx
stdout '^again.xlsx against vouched.xlsx: 0 inputs changed, 0 formulas changed, 0 computed values moved, 1 unexplained, 0 features lost, 0 unknown$'
stdout '^  Data!C3  999 → 10$'

# A value whose cause sheets cannot trace is unknown, not unexplained:
# INDIRECT names what it reads in text, and what reads it follows.
exec sheets set vol.xlsx Data!A1 5 Data!B1 '=INDIRECT("A1")*2' Data!C1 '=B1+1'
cp vol.xlsx vol2.xlsx
exec sheets set vol2.xlsx Data!A1 7
exec sheets check --fix vol2.xlsx
exec sheets check vol2.xlsx --against vol.xlsx
cmp stdout unknown.out

# A sheet renamed, to a name in any case: Excel rewrites the formulas that
# read it, which are not changes.
cp against_before.xlsx renamed.xlsx
exec sheets sheet rename renamed.xlsx Data Facts
exec sheets check renamed.xlsx --against against_before.xlsx
stdout '^renamed.xlsx against against_before.xlsx: 0 inputs changed, 0 formulas changed, 0 computed values moved, 0 unexplained, 0 features lost, 0 unknown$'
stdout '^  sheet renamed: Data → Facts$'
cp against_before.xlsx renamed2.xlsx
exec sheets sheet rename renamed2.xlsx Data 'My Facts'
exec sheets set renamed2.xlsx 'My Facts!B2' 6
exec sheets check renamed2.xlsx --against against_before.xlsx
stdout ': 1 input changed, 0 formulas changed, '
stdout ', 0 unexplained,'

# Rows added, then everything sorted: the alignment reads the rows as added
# at places where Excel never inserted any, but a total whose text is as it
# was is not a changed formula.
cp against_before.xlsx addsort.xlsx
exec sheets rows insert addsort.xlsx Data!7 -n 2
exec sheets set addsort.xlsx Data!A7 Far Data!B7 6 Data!C7 40 Data!D7 '=B7*C7' Data!A8 Near Data!B8 1 Data!C8 15 Data!D8 '=B8*C8'
exec sheets sort addsort.xlsx Data!A1:D8 Units
exec sheets check addsort.xlsx --against against_before.xlsx
stdout ': 0 inputs changed, 0 formulas changed, '
! stdout '=SUM\(B2:B6\) → =SUM\(B2:B6\)'
stdout ', 0 unexplained,'

# CSV files: values only, and rows moved.
exec sheets check after.csv --against before.csv
cmp stdout csv.out

# Nothing changed.
exec sheets check against_before.xlsx --against against_before.xlsx
stdout '^against_before.xlsx against against_before.xlsx: 0 inputs changed, 0 formulas changed, 0 computed values moved, 0 unexplained, 0 features lost, 0 unknown$'

! exec sheets check --fix input.xlsx --against against_before.xlsx
stderr 'run sheets check --fix on its own'

-- before.csv --
Name,Score
Ada,92
Bob,47
Cy,75
Di,60
-- after.csv --
Name,Score
Bob,47
Ada,92
Cy,80
Di,60
