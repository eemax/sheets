# A dynamic function XlsxWriter stores with cm="1", the range of its own
# cell and no result yet (=SEQUENCE(3) in D1) is a dynamic array over
# D1:D3 once Excel opens the file, so sort refuses it as it refuses one
# whose result is laid out; the refusal does not wait for check --fix.
fixture kinds_pending.xlsx
cp kinds_pending.xlsx before.xlsx
! exec sheets sort kinds_pending.xlsx S!A1:D6 A:desc
stderr 'S!A1:D6 holds the dynamic array formula in D1 or its result \(D1:D3\), which cannot be sorted; sort its source instead, or wrap it in SORT\(\)'
! exec sheets sort kinds_pending.xlsx S!C2:D3 C
stderr 'holds the dynamic array formula in D1 or its result \(D1:D3\)'
cmp kinds_pending.xlsx before.xlsx
# Rows clear of its result sort, and the file keeps its mark.
exec sheets sort kinds_pending.xlsx S!A4:D6 A:desc
stdout 'sorted S!A4:D6 by A descending'
part kinds_pending.xlsx xl/worksheets/sheet1.xml
stdout '<c r="D1"[^>]*cm="1"'
# The same once the results are laid out.
exec sheets check --fix kinds_pending.xlsx
! exec sheets sort kinds_pending.xlsx S!A1:D6 A:desc
stderr 'holds the dynamic array formula in D1 or its result \(D1:D3\)'

# A dynamic function sheets cannot compute (MAP over a LAMBDA) spills over
# D1:D3 in Excel, so its spill is unknown: a sort refuses whether it lies
# inside the range or just above it, where it would otherwise leave text in
# D4 to land under its spill.
fixture kinds_unknown.xlsx
cp kinds_unknown.xlsx before.xlsx
! exec sheets sort kinds_unknown.xlsx S!A2:D6 A
stderr 'S!A2:D6 may be reached by the dynamic array formula in D1, whose result sheets cannot work out'
! exec sheets sort kinds_unknown.xlsx S!A1:D6 A
stderr 'dynamic array formula in D1, whose result sheets cannot work out'
cmp kinds_unknown.xlsx before.xlsx
# Below it the spill may still reach, as far as sheets can tell; a range
# wholly left of its column cannot be reached, and sorts.
! exec sheets sort kinds_unknown.xlsx S!A4:D6 A
stderr 'may be reached by the dynamic array formula in D1'
cmp kinds_unknown.xlsx before.xlsx
exec sheets sort kinds_unknown.xlsx S!A2:B6 A
# Several of them: the first in the sheet's order is named, on every run
# (U!D1 here, not whichever the map gave first).
! exec sheets sort kinds_unknown.xlsx U!A1:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A1:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A1:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A1:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A1:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A1:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A3:D6 A
stderr 'formula in D1,'
! exec sheets sort kinds_unknown.xlsx U!A3:D6 A
stderr 'formula in D1,'
