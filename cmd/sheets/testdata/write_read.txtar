# Write TSV into a new workbook, then look at it every way.
stdin sales.tsv
exec sheets write book.xlsx Sales
cmp stdout write.out

exec sheets info book.xlsx
cmp stdout info.out

exec sheets peek book.xlsx
cmp stdout peek.out

exec sheets read book.xlsx Sales!A1:D3
cmp stdout read.out

exec sheets read book.xlsx 'Sales!F2:F4' --formulas
cmp stdout formulas.out

exec sheets read book.xlsx Sales -n 2
cmp stdout paged.out

exec sheets read book.xlsx Sales!A2:C3 --json
cmp stdout read.json

exec sheets read book.xlsx Sales!A1:C3 --format csv
cmp stdout read.csv

-- sales.tsv --
Date	Region	Units	Price	Share	Revenue
2026-07-01	North	120	$12.50	18%	=C2*D2
2026-07-02	South	80	$30.00	22.5%	=C3*D3
2026-07-03	East	2,000	$12.50	-3%	=C4*D4
Total		=SUM(C2:C4)			=SUM(F2:F4)
